# Copy to .env and fill in. Load with:  set -a; . ./.env; set +a
# SEC requires a User-Agent with a contact; www.sec.gov returns 403 without an email in it.
EDGAR_USER_AGENT="breach-tracker you@example.com"

# Exactly one LLM provider key is needed. LLM_PROVIDER picks the code path.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#DEEPSEEK_API_KEY=
#OPENROUTER_API_KEY=
#GROQ_API_KEY=
#LLM_MODEL=            # override the provider default in pipeline/extract.py

# Free PRO key from https://www.ransomware.live/my (the unauthenticated v2 API is gone).
RANSOMWARE_LIVE_API_KEY=

# Optional overrides
#MASTODON_TAG_URL=https://mastodon.social/api/v1/timelines/tag/databreach?limit=40
#HHS_CSV_URL=          # a saved breach_report.csv; otherwise the portal is driven live

# Optional. Daily share prices for 8-K filers older than the Nasdaq API's ~18 months of
# history. Free key at https://www.alphavantage.co/support/#api-key (25 requests/day).
ALPHAVANTAGE_API_KEY=
